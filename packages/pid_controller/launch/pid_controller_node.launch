<launch>
	<arg name="pkg_name" default="pid_controller" doc="name of the package"/>
	<arg name="node_name" default="pid_controller_node" doc="name of the node"/>
	<arg name="veh" doc="Name of vehicle. ex: megaman"/>

    <group ns="$(arg veh)">
		<node pkg="$(arg pkg_name)" type="$(arg node_name).py" name="$(arg node_name)" output="screen" required="true"/>
	</group>

    <!--
    We also have to launch the encoder pose node which is included in the
    recipe. For details about the encoder pose node, see the kinematics
    and modeling learning experience.
    -->
    <include file ="$(find encoder_pose)/launch/encoder_pose_node.launch">
        <arg name="veh" value="$(arg veh)"/>
    </include>

</launch>
